# The toolchain entry point, run INSIDE the container (the host launchers in
# scripts/ call it with docker exec). One implementation for every host OS.
#
#   imp build            build the project in /project (Tyra and the framework
#                        are built first when needed) and print IMPRESSION_ELF=
#   imp clean            remove the project's build output
#   imp make [args...]   run make in /project with the given arguments
#   imp build-engine     build Tyra's engine library (libtyra.a)
#   imp clean-engine     remove Tyra's build output
#   imp build-framework  build the framework library (builds Tyra first)
#   imp clean-framework  remove the framework's build output
#   imp sync-ide         copy Tyra/framework/toolchain headers into the project
#                        and (re)generate its .vscode/c_cpp_properties.json, so
#                        IntelliSense resolves <tyra> and <impression/...>
#                        without any manual download or path editing. Safe to
#                        re-run (e.g. after a toolchain or Tyra update); backs
#                        up an unrecognized existing c_cpp_properties.json
#                        instead of overwriting it silently.
#
# Layout: IMPRESSION_HOME holds the framework and extern/tyra (/work for framework
# development, /impression in the SDK); the project is always mounted at /project.
# Exit codes: 0 ok, 1 build failed, 2 usage or project error, 3 environment error.
# Everything printed to stdout is build output, except the IMPRESSION_ELF= line.
set -euo pipefail

EXIT_FAIL=1
EXIT_USAGE=2
EXIT_ENV=3

IMPRESSION_HOME="${IMPRESSION_HOME:-/work}"
PROJECT_DIR=/project
export IMPRESSION_HOME

die() {
    local code=$1
    shift
    echo "error: $*" >&2
    exit "$code"
}

require_engine_sources() {
    [ -f "$IMPRESSION_HOME/extern/tyra/Makefile.base" ] ||
        die "$EXIT_ENV" "Tyra sources not found in $IMPRESSION_HOME/extern/tyra (run: git submodule update --init --recursive)"
}

require_project() {
    [ -d "$PROJECT_DIR" ] || die "$EXIT_USAGE" "no project mounted at $PROJECT_DIR"
    [ -f "$PROJECT_DIR/Makefile" ] || die "$EXIT_USAGE" "no Makefile in the project folder ($PROJECT_DIR)"
}

# run_make <dir> [make args...]: make's own failure code (2) would collide with
# "usage", so any failure is reported as 1.
run_make() {
    local dir=$1
    shift
    local status=0
    make -C "$dir" "$@" || status=$?
    if [ "$status" -ne 0 ]; then
        echo "error: make failed in $dir (exit code $status)" >&2
        exit "$EXIT_FAIL"
    fi
}

# Tyra commits two placeholder files (engine/bin/.gitignore, engine/obj/.gitignore:
# "ignore everything here except this file") to keep those folders in git, and its
# `cleaner` target deletes them, which would leave the submodule looking modified.
# Recreate them byte for byte (the committed files use CRLF and have no final newline).
restore_engine_placeholders() {
    local engine="$IMPRESSION_HOME/extern/tyra/engine" dir
    for dir in bin obj; do
        mkdir -p "$engine/$dir"
        printf '# Ignore everything in this directory\r\n*\r\n# Except this file\r\n!.gitignore' >"$engine/$dir/.gitignore"
    done
}

# sync_ide: snapshot the headers a project's #include lines resolve to inside
# this container -- Tyra, the framework, and the toolchain's own ps2sdk/gcc/gsKit
# headers -- into <project>/.impression/include/, and point a generated
# .vscode/c_cpp_properties.json at them. Tyra and the framework headers are
# already on the host in the dev flavour (IMPRESSION_HOME is a bind mount
# there), but are copied here too so one config works unchanged in both
# flavours; the toolchain headers only exist inside the container either way.
sync_ide() {
    require_engine_sources
    require_project

    local out="$PROJECT_DIR/.impression/include"
    local ee_gcc_dir iop_gcc_dir
    ee_gcc_dir="$PS2DEV/ee/lib/gcc/mips64r5900el-ps2-elf"
    iop_gcc_dir="$PS2DEV/iop/lib/gcc/mipsel-none-elf"
    [ -d "$ee_gcc_dir" ] || die "$EXIT_ENV" "no EE gcc directory at $ee_gcc_dir"
    ee_gcc_dir="$ee_gcc_dir/$(basename "$(find "$ee_gcc_dir" -mindepth 1 -maxdepth 1 -type d | head -1)")"
    [ -d "$iop_gcc_dir" ] || die "$EXIT_ENV" "no IOP gcc directory at $iop_gcc_dir"
    iop_gcc_dir="$iop_gcc_dir/$(basename "$(find "$iop_gcc_dir" -mindepth 1 -maxdepth 1 -type d | head -1)")"

    echo "Copying headers into $out ..."
    rm -rf "$out"
    mkdir -p "$out"
    cp -r "$IMPRESSION_HOME/inc" "$out/impression"
    cp -r "$IMPRESSION_HOME/extern/tyra/engine/inc" "$out/tyra"
    mkdir -p "$out/ps2sdk"
    cp -r "$PS2SDK/common/include" "$out/ps2sdk/common"
    cp -r "$PS2SDK/ee/include" "$out/ps2sdk/ee"
    cp -r "$PS2SDK/iop/include" "$out/ps2sdk/iop"
    cp -r "$PS2SDK/ports/include" "$out/ps2sdk/ports"
    mkdir -p "$out/gcc-ee"
    cp -r "$ee_gcc_dir/include" "$out/gcc-ee/include"
    cp -r "$ee_gcc_dir/include-fixed" "$out/gcc-ee/include-fixed"
    cp -r "$PS2DEV/ee/mips64r5900el-ps2-elf/include" "$out/gcc-ee/sys-include"
    mkdir -p "$out/gcc-iop"
    cp -r "$iop_gcc_dir/include" "$out/gcc-iop/include"
    cp -r "$iop_gcc_dir/include-fixed" "$out/gcc-iop/include-fixed"
    cp -r "$GSKIT/include" "$out/gsKit"

    local vscode="$PROJECT_DIR/.vscode"
    local props="$vscode/c_cpp_properties.json"
    mkdir -p "$vscode"
    if [ -f "$props" ] && ! grep -q "auto-generated by imp sync-ide" "$props"; then
        cp "$props" "$props.bak"
        echo "note: $props did not look auto-generated; backed it up to $props.bak before overwriting" >&2
    fi
    cat >"$props" <<'JSON'
{
  "configurations": [
    {
      "name": "Impression Studio (auto-generated by imp sync-ide; re-run it to refresh, do not hand-edit)",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/.impression/include/impression/**",
        "${workspaceFolder}/.impression/include/tyra/**",
        "${workspaceFolder}/.impression/include/ps2sdk/common/**",
        "${workspaceFolder}/.impression/include/ps2sdk/ee/**",
        "${workspaceFolder}/.impression/include/ps2sdk/iop/**",
        "${workspaceFolder}/.impression/include/ps2sdk/ports/**",
        "${workspaceFolder}/.impression/include/gcc-ee/include/**",
        "${workspaceFolder}/.impression/include/gcc-ee/include-fixed/**",
        "${workspaceFolder}/.impression/include/gcc-ee/sys-include/**",
        "${workspaceFolder}/.impression/include/gcc-iop/include/**",
        "${workspaceFolder}/.impression/include/gcc-iop/include-fixed/**",
        "${workspaceFolder}/.impression/include/gsKit/**"
      ],
      "defines": ["_EE", "_IOP", "INTELLISENSE"],
      "cppStandard": "c++20",
      "cStandard": "c17",
      "compilerPath": "",
      "intelliSenseMode": "linux-gcc-x86",
      "configurationProvider": "ms-vscode.cpptools"
    }
  ],
  "version": 4
}
JSON

    local ext="$vscode/extensions.json"
    if [ ! -f "$ext" ]; then
        cat >"$ext" <<'JSON'
{
  "recommendations": ["ms-vscode.cpptools"]
}
JSON
    fi
    echo "Wrote $props"
}

# The project-relative path of the single ELF in bin/.
print_elf() {
    local found=()
    shopt -s nullglob
    found=("$PROJECT_DIR"/bin/*.elf)
    shopt -u nullglob
    [ "${#found[@]}" -ge 1 ] || die "$EXIT_USAGE" "no .elf in $PROJECT_DIR/bin after the build"
    [ "${#found[@]}" -eq 1 ] || die "$EXIT_USAGE" "more than one .elf in $PROJECT_DIR/bin: ${found[*]}"
    echo "IMPRESSION_ELF=bin/$(basename "${found[0]}")"
}

command=${1:-help}
[ "$#" -eq 0 ] || shift

case "$command" in
    build)
        require_engine_sources
        require_project
        run_make "$PROJECT_DIR"
        print_elf
        ;;
    clean)
        require_project
        run_make "$PROJECT_DIR" cleaner
        ;;
    make)
        require_engine_sources
        require_project
        run_make "$PROJECT_DIR" "$@"
        ;;
    build-engine)
        require_engine_sources
        run_make "$IMPRESSION_HOME/extern/tyra/engine"
        ;;
    clean-engine)
        require_engine_sources
        run_make "$IMPRESSION_HOME/extern/tyra/engine" cleaner
        restore_engine_placeholders
        ;;
    build-framework)
        require_engine_sources
        run_make "$IMPRESSION_HOME"
        ;;
    clean-framework)
        run_make "$IMPRESSION_HOME" clean
        ;;
    sync-ide)
        sync_ide
        ;;
    help | -h | --help)
        sed -n '5,22p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
        ;;
    *)
        die "$EXIT_USAGE" "unknown command: $command (try: imp help)"
        ;;
esac
