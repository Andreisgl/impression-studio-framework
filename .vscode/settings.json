{
  "terminal.integrated.profiles.windows": {
    "PowerShell (bypass policy)": {
      "path": "${env:windir}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass"
      ]
    }
  },
  "terminal.integrated.defaultProfile.windows": "PowerShell (bypass policy)"
}
